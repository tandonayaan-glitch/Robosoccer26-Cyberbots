// secrets.h.example - TEMPLATE with placeholders only. Do NOT put real values in this file (it is committed to Git).
//
//   1. Easiest:  python3 tools/provision.py --mega-port <your Mega's serial port>     (generates real values, writes remote_esp32/secrets.h, stores the key in the Mega)
//   2. By hand:  copy this file to remote_esp32/secrets.h (that name is in .gitignore) and replace the two placeholders.
//
// SHARED_KEY_HEX   : 64 hexadecimal characters = 32 random bytes. Must be IDENTICAL on the ESP32 (this file) and the Mega (USB command  :authkey <the same 64 hex>).
// CONSOLE_PASSCODE : what you type in the ESP32's USB Serial Monitor:  esp32connect <passcode>.  At least 8 characters. Anyone who knows it can unlock the remote.
// CONSOLE_REQUIRE_PASSCODE : 1 (default, recommended) = esp32connect needs the passcode. 0 = 'esp32connect' alone connects: convenient, but then anyone with USB access to the ESP32 can drive the robot.
#define SHARED_KEY_HEX   "REPLACE_WITH_64_HEX_CHARACTERS"
#define CONSOLE_PASSCODE "REPLACE_WITH_PASSCODE"
#define CONSOLE_REQUIRE_PASSCODE 1
#define CONSOLE_IDLE_LOCK_MS 0UL          // 0 = stay connected until you type esp32disconnect (or the ESP32 restarts). Set e.g. 300000UL to also lock after 5 idle minutes.
